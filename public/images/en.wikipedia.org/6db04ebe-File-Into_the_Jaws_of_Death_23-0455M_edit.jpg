					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="en" dir="ltr" data-mw-parsoid-version="0.24.0.0-alpha22" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><div class="shortdescription nomobile noexcerpt noprint searchaux" style="display:none" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Short description","href":"./Template:Short_description"},"params":{"1":{"wt":"World War II operation in France"}},"i":0}}]}'>World War II operation in France</div><span class="mw-empty-elt" about="#mwt1"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"/><link rel="mw:PageProp/Category" href="./Category:Short_description_is_different_from_Wikidata"/></span>
<span class="mw-empty-elt" about="#mwt2" typeof="mw:Transclusion" id="mwAw" data-mw='{"parts":[{"template":{"target":{"wt":"for","href":"./Template:For"},"params":{"1":{"wt":"the Vietnam War operation"},"2":{"wt":"Battle of Long Khánh"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1368532237" typeof="mw:Extension/templatestyles" about="#mwt3" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .hatnote{font-style:italic}.mw-parser-output div.hatnote{padding-left:1.6em;margin-bottom:0.5em}.mw-parser-output .hatnote i{font-style:normal}.mw-parser-output .hatnote+.mw-empty-elt+.hatnote{margin-top:-0.5em}@media print{body.ns-0 .mw-parser-output .hatnote{display:none!important}}</style></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt2" id="mwBA">For the Vietnam War operation, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Battle_of_Long_Khánh" title="Battle of Long Khánh">Battle of Long Khánh</a>.</div>
<span class="mw-empty-elt" about="#mwt4" typeof="mw:Transclusion" id="mwBQ" data-mw='{"parts":[{"template":{"target":{"wt":"redirect","href":"./Template:Redirect"},"params":{"1":{"wt":"Normandy campaign"},"2":{"wt":"the 13th-century campaigns"},"3":{"wt":"French invasion of Normandy (1202–1204)"}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1368532237" about="#mwt5" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'/></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt4" id="mwBg">"Normandy campaign" redirects here. For the 13th-century campaigns, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/French_invasion_of_Normandy_(1202–1204)" title="French invasion of Normandy (1202–1204)" class="mw-redirect">French invasion of Normandy (1202–1204)</a>.</div>
<p class="mw-empty-elt" id="mwBw"><span typeof="mw:Nowiki mw:Transclusion" about="#mwt6" id="mwCA" data-mw='{"parts":[{"template":{"target":{"wt":"Good article","href":"./Template:Good_article"},"params":{},"i":0}}]}'></span><meta typeof="mw:Extension/indicator" about="#mwt6" id="mwCQ" data-mw='{"name":"indicator","attrs":{"name":"good-star"},"body":{"extsrc":"[[File:symbol support vote.svg|20x20px |link=Wikipedia:Good articles*   |This is a good article. Click here for more information.]]\n"}}'/><link rel="mw:PageProp/Category" href="./Category:Good_articles" about="#mwt6" id="mwCg"/>
<span typeof="mw:Nowiki mw:Transclusion" about="#mwt8" id="mwCw" data-mw='{"parts":[{"template":{"target":{"wt":"Use dmy dates","href":"./Template:Use_dmy_dates"},"params":{"date":{"wt":"May 2022"}},"i":0}}]}'></span><link rel="mw:PageProp/Category" href="./Category:Use_dmy_dates_from_May_2022" about="#mwt8" id="mwDA"/>
<span typeof="mw:Nowiki mw:Transclusion" about="#mwt9" id="mwDQ" data-mw='{"parts":[{"template":{"target":{"wt":"Use British English","href":"./Template:Use_British_English"},"params":{"date":{"wt":"April 2014"}},"i":0}}]}'></span><link rel="mw:PageProp/Category" href="./Category:Use_British_English_from_April_2014" about="#mwt9"/><link rel="mw:PageProp/Category" href="./Category:All_Wikipedia_articles_written_in_British_English" about="#mwt9" id="mwDg"/></p>
<span class="mw-empty-elt" about="#mwt10" typeof="mw:Transclusion" id="mwDw" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox military conflict\n","href":"./Template:Infobox_military_conflict"},"params":{"conflict":{"wt":"Operation Overlord"},"part_of":{"wt":"the [[Western Front (World War II)|Western Front]] of [[World War II]]"},"image":{"wt":"NormandySupply edit.jpg"},"image_upright":{"wt":"1.0"},"caption":{"wt":"[[Landing ship tank|LSTs]] with [[barrage balloon]]s deployed, unloading supplies on [[Omaha Beach]] for the breakout from Normandy"},"date":{"wt":"6 June&amp;nbsp;– 30 August 1944\n&lt;br />({{Age in years, months, weeks and days|month1=6\n|day1=6|year1=1944|month2=08|day2=30|year2=1944}})"},"location":{"wt":"Northern [[France]]"},"coordinates":{"wt":"{{Coord|49.34|N|0.60|W|region:FR-NOR|display=inline,title}}"},"result":{"wt":"Allied victory"},"combatant1":{"wt":"{{plainlist |\n* &apos;&apos;&apos;[[Allies of World War II|Allies]]&apos;&apos;&apos;\n* {{flag|United States|1912}}\n* {{flag|United Kingdom}}\n* {{flag|Canada|1921}}\n* {{flagcountry|Provisional Government of the French Republic}}\n* {{flagdeco|Poland|1928}} [[Polish government-in-exile|Poland]]{{sfn|Beevor|2009|p=82}}\n* {{flag|Australia}}\n* {{flagcountry|Dominion of New Zealand}}{{sfn|Beevor|2009|p=76}}\n* {{flagicon|Belgium}} [[Free Belgian forces|Belgium]]{{sfn|Williams|1988|p=x}}\n* {{flagcountry|Czechoslovak government-in-exile}}{{sfn|Beevor|2009|p=492}}\n* {{flagcountry|Greek government-in-exile}}{{sfn|US Navy website}}\n* {{flagdeco|Luxembourg}} [[Free Luxembourgish forces|Luxembourg]]{{sfn|Luxembourg Army website}}\n* {{flagdeco|Netherlands}} [[Dutch government-in-exile|Netherlands]]{{sfn|Williams|1988|p=x}}\n* {{Flagdeco|Norway}} [[Nygaardsvold&apos;s Cabinet|Norway]]{{sfn|Beevor|2009|p=82}}\n* {{flagcountry|Union of South Africa}}{{sfn|Meadows|2016}}\n* {{flag|Southern Rhodesia}}{{sfn|Meadows|2016}}\n}}"},"combatant2":{"wt":"&apos;&apos;&apos;[[Axis powers|Axis]]&apos;&apos;&apos;&lt;br>{{flagcountry|Nazi Germany|name=Germany}}&lt;br>{{flag|Italian Social Republic}}{{efn|The Italian Social Republic forces during Operation Overlord were composed of the 4,000 men of the {{ill|1st Atlantic Naval Infantry Division|it|1ª Divisione Atlantica Fucilieri di Marina}}. About 200 of them were stationed on the island of [[Cézembre]] during the [[Battle of Saint-Malo#Cézembre|Battle of Saint-Malo]].{{sfn|Viganò|1991|p=181}} Other forces include former prisoners-of-war put in labor and anti-air units.{{sfn|Frittoli|2019}} }}"},"commander1":{"wt":"{{unbulleted list\n|&apos;&apos;&apos;&lt;u>[[Supreme Headquarters Allied Expeditionary Force|SHAEF]]&lt;/u>:&apos;&apos;&apos;\n|{{nowrap|{{flagicon|United States|1912}} [[Dwight D. Eisenhower]]}}\n|&apos;&apos;&apos;&lt;u>[[21st Army Group]]&lt;/u>:&apos;&apos;&apos;\n|{{flagicon|United Kingdom}} [[Bernard Montgomery]]\n|{{flagicon|United Kingdom}} [[Miles Dempsey]]\n|{{flagicon|United States}} [[Omar Bradley]]\n|{{flagdeco|Canada|1921}} [[Harry Crerar]]\n|{{flagicon|United States}} [[George S. Patton]]\n|&apos;&apos;&apos;&lt;u>[[Allied Expeditionary Air Force|Allied Air Force]]&lt;/u>:&apos;&apos;&apos;\n|{{nowrap|{{flagicon|United Kingdom}} [[Trafford Leigh-Mallory]]}}\n|{{flagicon|United States}} [[Hoyt Vandenberg]]\n|{{flagicon|United Kingdom}} [[Arthur Coningham (RAF officer)|Arthur Coningham]]\n|&apos;&apos;&apos;&lt;u>Allied naval force&lt;/u>:&apos;&apos;&apos;\n* {{flagicon|United Kingdom}} [[Bertram Ramsay]]\n}}"},"commander2":{"wt":"{{ubl\n|&apos;&apos;&apos;&lt;u>[[OKW]]&lt;/u>:&apos;&apos;&apos;\n|{{flagicon|Nazi Germany|1935}} [[Adolf Hitler]]\n|&apos;&apos;&apos;&lt;u>[[OB West]]&lt;/u>&apos;&apos;&apos;\n|{{flagicon|Nazi Germany|1935}} [[Gerd von Rundstedt]]\n|{{flagicon|Nazi Germany|1935}} [[Günther von Kluge]]\n|&apos;&apos;&apos;&lt;u>[[Army Group B]]&lt;/u>&apos;&apos;&apos;\n|{{flagicon|Nazi Germany|1935}} [[Erwin Rommel]]\n|{{flagicon|Nazi Germany|1935}} [[Walter Model]]\n|{{flagicon|Nazi Germany|1935}} [[Friedrich Dollmann]]\n|{{flagicon|Nazi Germany|1935}} [[Paul Hausser]]\n|{{flagicon|Nazi Germany|1935}} [[Kurt von der Chevallerie|Kurt v.d. Chevallerie]]\n|&apos;&apos;&apos;&lt;u>[[Panzer Group West]]&lt;/u>&apos;&apos;&apos;:\n|{{nowrap|{{flagicon|Nazi Germany|1935}} [[Leo Geyr von Schweppenburg|Leo v. Schweppenburg]]}}\n|{{flagicon|Nazi Germany|1935}} [[Heinrich Eberbach]]\n}}"},"strength1":{"wt":"{{plainlist |\n* More than 1,452,000 troops by 25 July{{efn| Around 812,000 were American and 640,000 were British or Canadian{{sfn|Zetterling|2000|p=408}} }}\n* 2,052,299 (by the end of August){{sfn|Badsey|1990|p=85}}\n}}"},"strength2":{"wt":"{{plainlist |\n* 380,000 troops (by 23 July){{sfn|Zetterling|2000|p=32}}\n* ~640,000 troops total{{sfn|Zetterling|2000|p=34}}\n* 2,200{{sfn|Shulman|2007|p=192}}–2,500 tanks and assault guns{{sfn|Wilmot|1997|p=434}}{{sfn|Buckley|2006|pp=117–120}}\n}}"},"casualties1":{"wt":"{{plainlist |\n* {{flagicon|United States|1912}} 124,394 casualties; 20,668 killed{{efn|name=American casualties |American casualties are sourced from the G-3 War Room Summary 91, dated 5 September 1944, covering the campaign.{{sfn|Pogue|1954|loc=Chapter XIV, footnote 10}} In 1953, the US Statistical and Accounting Branch, Office of the Adjutant General issued a final report on US casualties (excluding Air Force losses) for the period from 6 June to 14 September 1944. This source shows the number killed in action during the Battle of Normandy (6 June – 24 July 1944) as 13,959 and Northern France (25 July to 14 September 1944) as 15,239 for a total of 29,198. Total deaths among battle casualties (including accidental deaths, disease, etc) for Normandy (6 June – 24 July 1944) were 16,293 and in Northern France (25 July – 14 September 1944) were 17,844, for a total of 34,137.{{sfn|US Army|1953|p=92}}}}\n* {{flagicon|United Kingdom}} ~65,000 casualties; 11,000 killed; 54,000 wounded or missing{{sfn|britannica.com}}\n* {{flagicon|Canada|1921}} 18,444 casualties; 5,021 killed{{sfn|Stacey|1960|p=271}}\n* {{flagicon|Poland|1928}} 2,097 casualties{{sfn|Maczek|2006}}\n}}\n\n16,714 Allied airmen killed (8,536 members of the USAAF, and 8,178 flying under the command of the RAF)\n----\n{{plainlist |\n* 226,386 casualties in total{{sfn|Tamelander|Zetterling|2003|p=341}}{{efn|In addition, the Allied air forces made 480,317 sorties directly connected to the operation, with the loss of 4,101 planes and 16,714 lives.{{sfn|Tamelander|Zetterling|2003|p=341}}}}\n* 4,101 aircraft{{sfn|Tamelander|Zetterling|2003|p=341}}\n* ~4,000 tanks{{sfn|Tamelander|Zetterling|2003|p=342}}\n}}"},"casualties2":{"wt":"{{plainlist |\n* ~80,000 killed{{sfn|Inman|Staines|2019|loc=La Cambe German Military Cemetery}}&lt;br>233,000 captured&lt;ref>&apos;&apos;SHAEF Weekly Intelligence Summary, No.51&apos;&apos;, w.e. March 11 PART I LAND Section H, Miscellaneous 3 Allied Achievements in the West&lt;/ref>&lt;br>[[Operation Overlord#Germany|Casualties differ by source]]\n* 2,127 aircraft{{sfn|Tamelander|Zetterling|2003|pp=342–343}}\n* 1,500{{sfn|Zetterling|2000|p=83}}–2,400 tanks and assault guns lost{{sfn|Wilmot|1997|p=434}}\n}}"},"casualties3":{"wt":"&apos;&apos;&apos;Civilian deaths:&apos;&apos;&apos;\n{{plainlist |\n* 11,000–19,000 killed in pre-invasion bombing{{sfn|Beevor|2009|p=519}}\n* 13,632–19,890 killed during invasion{{sfn|Flint|2009|pp=336–337}}\n* &apos;&apos;&apos;Total:&apos;&apos;&apos; 25,000–39,000 killed\n}}"},"campaignbox":{"wt":"{{Campaignbox Normandy}}\n{{Campaignbox Western Europe (1944–1945)}}\n{{Campaignbox Western Front (World War II)}}\n{{Campaignbox Free French}}"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r963460841" typeof="mw:Extension/templatestyles" about="#mwt11" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox military conflict/styles.css"},"body":{"extsrc":""}}'>@media all and (min-width:720px){.mw-parser-output .desktop-float-right{box-sizing:border-box;float:right;clear:right}}.mw-parser-output .infobox.vevent .status>p:first-child{margin:0}</style><style data-mw-deduplicate="TemplateStyles:r1034237262" typeof="mw:Extension/templatestyles" about="#mwt12" data-mw='{"name":"templatestyles","attrs":{"src":"Stack/styles.css"}}'>.mw-parser-output .stack{box-sizing:border-box}.mw-parser-output .stack>div{margin:1px;overflow:hidden}@media all and (min-width:720px){.mw-parser-output .stack-clear-left{float:left;clear:left}.mw-parser-output .stack-clear-right{float:right;clear:right}.mw-parser-output .stack-left{float:left}.mw-parser-output .stack-right{float:right}.mw-parser-output .stack-margin-clear-left{float:left;clear:left;margin-right:1em}.mw-parser-output .stack-margin-clear-right{float:right;clear:right;margin-left:1em}.mw-parser-output .stack-margin-left{float:left;margin-right:1em}.mw-parser-output .stack-margin-right{float:right;margin-left:1em}}</style></span><div class="stack mw-stack stack-clear-right" about="#mwt10" id="mwEA"><div><table class="infobox vevent" style="width:25.5em;border-spacing:2px;"><tbody><tr><th class="summary" colspan="2" style="background-color:#C3D6EF;color:inherit;text-align:center;vertical-align:middle;font-size:110%;">Operation Overlord</th></tr><tr><td colspan="2" style="background-color:#DCDCDC;color:inherit;text-align:center;vertical-align:middle;">Part of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Western_Front_(World_War_II)" title="Western Front (World War II)">Western Front</a> of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/World_War_II" title="World War II">World War II</a></td></tr><tr><td colspan="2" style="text-align:center;border-bottom:1px solid #aaa;line-height:1.5em;"><span class="mw-default-size" typeof="mw:File/Frameless"><a href="https://en.wikipedia.org/wiki/File:NormandySupply_edit.jpg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:NormandySupply_edit.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/6/66/NormandySupply_edit.jpg/250px-NormandySupply_edit.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/6/66/NormandySupply_edit.jpg/500px-NormandySupply_edit.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="2804" data-file-height="2150" data-file-type="bitmap" height="192" width="250" class="mw-file-element mw-file-upright" style="--mw-file-upright: 1"/></a></span><br/><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Landing_ship_tank" title="Landing ship tank" class="mw-redirect">LSTs</a> with <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Barrage_balloon" title="Barrage balloon">barrage balloons</a> deployed, unloading supplies on <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Omaha_Beach" title="Omaha Beach">Omaha Beach</a> for the breakout from Normandy</td></tr><tr><td colspan="2"><table style="width:100%;margin:0;padding:0;border:0;display:inline-table"><tbody><tr><th style="padding-right:1em">Date</th><td>6 June<span typeof="mw:Entity"> </span>– 30 August 1944
<br/>(2<span typeof="mw:Entity"> </span>months, 3<span typeof="mw:Entity"> </span>weeks and 3<span typeof="mw:Entity"> </span>days)</td></tr><tr><th style="padding-right:1em">Location</th><td><div class="location">Northern <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/France" title="France">France</a></div><span class="geo-inline"><style data-mw-deduplicate="TemplateStyles:r1156832818" typeof="mw:Extension/templatestyles" about="#mwt13" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Coordinates/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .geo-default,.mw-parser-output .geo-dms,.mw-parser-output .geo-dec{display:inline}.mw-parser-output .geo-nondefault,.mw-parser-output .geo-multi-punct,.mw-parser-output .geo-inline-hidden{display:none}.mw-parser-output .longitude,.mw-parser-output .latitude{white-space:nowrap}</style><span class="plainlinks nourlexpansion"><a rel="mw:ExtLink" href="https://geohack.toolforge.org/geohack.php?pagename=Operation_Overlord&amp;params=49.34_N_0.60_W_region:FR-NOR" class="external text"><span class="geo-nondefault"><span class="geo-dms" title="Maps, aerial photos, and other data for this location"><span class="latitude">49°20′N</span> <span class="longitude">0°36′W</span></span></span><span class="geo-multi-punct"><span typeof="mw:Entity">﻿</span> / <span typeof="mw:Entity">﻿</span></span><span class="geo-default"><span class="geo-dec" title="Maps, aerial photos, and other data for this location">49.34°N 0.60°W</span><span style="display:none"><span typeof="mw:Entity">﻿</span> / <span class="geo">49.34; -0.60</span></span></span></a></span><link rel="mw:PageProp/Category" href="./Category:Pages_using_gadget_WikiMiniAtlas"/></span><meta typeof="mw:Extension/indicator" about="#mwt15" id="mwEQ" data-mw='{"name":"indicator","attrs":{"name":"coordinates"},"body":{"extsrc":"&lt;span id=\"coordinates\">[[Geographic coordinate system|Coordinates]]: {{#parsoid\u0000fragment:68}}&lt;span class=\"plainlinks nourlexpansion\">[https://geohack.toolforge.org/geohack.php?pagename=Operation_Overlord&amp;params=49.34_N_0.60_W_region:FR-NOR &lt;span class=\"geo-nondefault\">&lt;span class=\"geo-dms\" title=\"Maps, aerial photos, and other data for this location\">&lt;span class=\"latitude\">49°20′N&lt;/span> &lt;span class=\"longitude\">0°36′W&lt;/span>&lt;/span>&lt;/span>&lt;span class=\"geo-multi-punct\">&amp;#xfeff; / &amp;#xfeff;&lt;/span>&lt;span class=\"geo-default\">&lt;span class=\"geo-dec\" title=\"Maps, aerial photos, and other data for this location\">49.34°N 0.60°W&lt;/span>&lt;span style=\"display:none\">&amp;#xfeff; / &lt;span class=\"geo\">49.34; -0.60&lt;/span>&lt;/span>&lt;/span>]&lt;/span>[[Category:Pages using gadget WikiMiniAtlas]]&lt;/span>"}}'/><link rel="mw:PageProp/Category" href="./Category:Coordinates_on_Wikidata"/></td></tr><tr><th style="padding-right:1em">Result</th><td class="status">
Allied victory</td></tr></tbody></table></td></tr><tr><th colspan="2" style="background-color:#C3D6EF;color:inherit;text-align:center;vertical-align:middle;font-size:110%;">Belligerents</th></tr><tr><td style="width:50%;border-right:1px dotted #aaa;">
<span class="mw-empty-elt"><style data-mw-deduplicate="TemplateStyles:r1126788409" typeof="mw:Extension/templatestyles" about="#mwt18" data-mw='{"name":"templatestyles","attrs":{"src":"Plainlist/styles.css"}}'>.mw-parser-output .plainlist ol,.mw-parser-output .plainlist ul{line-height:inherit;list-style:none;margin:0;padding:0}.mw-parser-output .plainlist ol li,.mw-parser-output .plainlist ul li{margin-bottom:0}</style></span><div class="plainlist ">
