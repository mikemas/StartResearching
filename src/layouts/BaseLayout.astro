---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Start Researching Genealogy — guides, records, and research tips.' } = Astro.props;
import Nav from '../components/Nav.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Start Researching</title>
    <style is:global>
      :root { --teal: #5bc0c5; --ink: #222; --muted: #999; --line: #e6e6e6; --periwinkle: #8a8ac1; }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: #fff; color: var(--ink);
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 16px; line-height: 1.7;
      }
      a { color: var(--teal); }

      /* Fixed left sidebar, like the Squarespace template */
      .layout { display: flex; align-items: stretch; min-height: 100vh; }
      .sidebar {
        width: 300px; flex: 0 0 300px; padding: 64px 34px 40px 44px;
        position: sticky; top: 0; height: 100vh; overflow-y: auto;
      }
      .sidebar .logo img { width: 205px; max-width: 100%; height: auto; display: block; }
      nav.main-nav ul {
        list-style: none; margin: 44px 0 0; padding: 0;
        display: flex; flex-direction: column; gap: 19px;
      }
      nav.main-nav a {
        color: #1a1a1a; text-decoration: none; font-size: 19px; line-height: 1.35;
      }
      nav.main-nav a:hover { color: var(--teal); }
      nav.main-nav a.active { color: var(--teal); }
      .sidebar .secondary { margin-top: 44px; display: flex; flex-direction: column; gap: 12px; }
      .sidebar .secondary a { color: var(--periwinkle); text-decoration: none; font-size: 17px; }
      .sidebar .secondary a:hover { color: var(--teal); }

      .content { flex: 1 1 auto; min-width: 0; }
      main { max-width: 830px; padding: 64px 60px 70px 30px; }

      /* Blog stream */
      .post { margin: 0 0 76px; }
      .post-title { font-size: 34px; font-weight: 700; line-height: 1.25; margin: 6px 0 18px; }
      .post-title a { color: #1a1a1a; text-decoration: none; }
      .post-title a:hover { color: var(--teal); }
      .post-footer { margin-top: 26px; font-size: 13px; }
      .post-footer a { color: var(--muted); text-decoration: none; }
      .post-footer a:hover { color: var(--teal); }
      .archive-link { margin: 20px 0 60px; }

      /* Article content */
      article img { max-width: 100%; height: auto; display: block; margin: 1.6em auto; }
      figure { margin: 1.6em 0; text-align: center; }
      figcaption, .image-caption, .sqs-image-caption {
        color: #888; font-size: 13px; margin-top: 6px;
      }
      h1, h2, h3 { line-height: 1.3; color: #1a1a1a; }
      blockquote { border-left: 3px solid var(--teal); margin: 1.5em 0; padding: 0.2em 0 0.2em 1em; color: #555; }
      table { border-collapse: collapse; width: 100%; font-size: 14px; }
      th, td { border: 1px solid var(--line); padding: 6px 10px; text-align: left; }
      .sqs-gallery-container { text-align: center; }
      .sqs-gallery-container .thumb-image {
        width: 158px !important; height: 158px !important;
        object-fit: cover; display: inline-block !important;
        margin: 4px !important; vertical-align: top;
      }
      .sqs-gallery-meta { display: none; }
      button.lightbox { all: unset; }

      footer.site-footer {
        color: var(--muted); font-size: 13px; padding: 10px 0 44px; letter-spacing: 0.4px;
      }
      footer.site-footer a { color: var(--muted); }
      footer.site-footer a:hover { color: var(--teal); }

      @media (max-width: 820px) {
        .layout { flex-direction: column; }
        .sidebar {
          width: auto; flex: none; height: auto; position: static;
          padding: 28px 22px 0; overflow: visible;
        }
        .sidebar .logo img { width: 170px; }
        nav.main-nav ul { flex-direction: row; flex-wrap: wrap; gap: 6px 18px; margin-top: 22px; }
        nav.main-nav a { font-size: 15px; }
        .sidebar .secondary { flex-direction: row; flex-wrap: wrap; gap: 4px 16px; margin: 16px 0 8px; }
        main { padding: 26px 22px 60px; }
      }
    </style>
  </head>
  <body>
    <div class="layout">
      <aside class="sidebar">
        <a class="logo" href="/" aria-label="Start Researching home">
          <img src="/images/logo.png" alt="Start Researching Genealogy" />
        </a>
        <Nav />
        <div class="secondary">
          <a href="https://www.etsy.com/shop/startresearching">Our Etsy Shop</a>
          <a href="/contact-me">Contact</a>
          <a href="/ciphers">Ciphers</a>
          <a href="/voynich-blog">Voynich</a>
        </div>
      </aside>
      <div class="content">
        <main>
          <slot />
        </main>
        <footer class="site-footer">
          <p>© {new Date().getFullYear()} Start Researching Genealogy</p>
        </footer>
      </div>
    </div>
  </body>
</html>
