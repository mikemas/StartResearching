---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Start Researching Genealogy — guides, records, and research tips.' } = Astro.props;
import Nav from '../components/Nav.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Start Researching</title>
    <style>
      :root { --teal: #0f766e; --ink: #333; --muted: #999; --line: #e6e6e6; }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: #fff; color: var(--ink);
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 16px; line-height: 1.7;
      }
      a { color: var(--teal); }

      /* Header — centered logo like the Squarespace template */
      .site-header { text-align: center; padding: 42px 20px 0; }
      .site-header .logo img { max-width: 430px; width: 82%; height: auto; }
      nav.main-nav ul {
        list-style: none; margin: 0; padding: 20px 12px 8px;
        display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 24px;
      }
      nav.main-nav { border-bottom: 1px solid var(--line); padding-bottom: 14px; }
      nav.main-nav a {
        color: #666; text-decoration: none; font-size: 13px;
        letter-spacing: 1.5px; text-transform: uppercase; white-space: nowrap;
      }
      nav.main-nav a:hover { color: var(--teal); }

      main { max-width: 730px; margin: 0 auto; padding: 34px 22px 70px; }

      /* Blog stream */
      .post { margin: 0 0 76px; }
      .post-title {
        font-size: 33px; font-weight: 400; line-height: 1.28;
        text-align: center; margin: 6px 0 4px;
      }
      .post-title a { color: #222; text-decoration: none; }
      .post-title a:hover { color: var(--teal); }
      .post-meta {
        text-align: center; color: var(--muted); font-size: 13px;
        letter-spacing: 0.5px; margin: 10px 0 28px;
      }
      .post-meta a { color: var(--muted); text-decoration: none; }
      .post-meta a:hover { color: var(--teal); }
      .post-footer { text-align: center; margin-top: 26px; font-size: 13px; }
      .post-footer a { color: var(--muted); text-decoration: none; }
      .post-footer a:hover { color: var(--teal); }
      .archive-link { text-align: center; margin: 20px 0 60px; }

      /* Article content */
      article img { max-width: 100%; height: auto; display: block; margin: 1.6em auto; }
      figure { margin: 1.6em 0; text-align: center; }
      figcaption, .image-caption, .sqs-image-caption {
        color: #888; font-size: 13px; margin-top: 6px;
      }
      h1, h2, h3 { line-height: 1.3; color: #222; font-weight: 500; }
      blockquote { border-left: 3px solid var(--teal); margin: 1.5em 0; padding: 0.2em 0 0.2em 1em; color: #555; }
      table { border-collapse: collapse; width: 100%; font-size: 14px; }
      th, td { border: 1px solid var(--line); padding: 6px 10px; text-align: left; }
      /* Squarespace gallery thumbs become a tidy grid without their JS */
      .sqs-gallery-container { text-align: center; }
      .sqs-gallery-container .thumb-image {
        width: 158px !important; height: 158px !important;
        object-fit: cover; display: inline-block !important;
        margin: 4px !important; vertical-align: top;
      }
      .sqs-gallery-meta { display: none; }
      button.lightbox { all: unset; }

      footer.site-footer {
        border-top: 1px solid var(--line); text-align: center;
        color: var(--muted); font-size: 13px; padding: 30px 20px 44px;
        letter-spacing: 0.4px;
      }
      footer.site-footer a { color: var(--muted); }
      footer.site-footer a:hover { color: var(--teal); }
    </style>
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/" aria-label="Start Researching home">
        <img src="/images/logo.png" alt="Start Researching Genealogy" />
      </a>
      <Nav />
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Start Researching Genealogy</p>
      <p>
        <a href="https://www.etsy.com/shop/startresearching">Our Etsy Shop</a>
        &nbsp;·&nbsp; <a href="/contact-me">Contact</a>
      </p>
    </footer>
  </body>
</html>
