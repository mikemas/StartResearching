---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Start Researching Genealogy — guides, records, and research tips.' } = Astro.props;
import Nav from '../components/Nav.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Start Researching</title>
    <style>
      :root { --teal: #0f766e; --ink: #1f2937; --bg: #ffffff; --muted: #f3f4f6; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; color: var(--ink); background: var(--bg); line-height: 1.6; }
      header { border-bottom: 1px solid #e5e7eb; padding: 1rem 1.5rem; }
      .brand { font-weight: 800; font-size: 1.25rem; color: var(--teal); text-decoration: none; }
      main { max-width: 72ch; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
      footer { border-top: 1px solid #e5e7eb; padding: 2rem 1.5rem; color: #6b7280; font-size: 0.9rem; text-align: center; }
      a { color: var(--teal); }
      nav ul { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
      nav a { text-decoration: none; }
      nav a:hover { text-decoration: underline; }
      .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; margin-top: 2rem; }
      .card { border: 1px solid #e5e7eb; border-radius: 12px; padding: 1rem; background: #fff; }
      .card h3 { margin: 0 0 0.5rem; font-size: 1rem; }
      .card p { margin: 0; font-size: 0.9rem; color: #4b5563; }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href="/">Start Researching Genealogy</a>
      <Nav />
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>© {new Date().getFullYear()} Start Researching. Replacement build (Astro) — content migrates from Squarespace.</p>
      <p><a href="https://www.etsy.com/shop/startresearching">Our Etsy Shop</a> · <a href="/contact">Contact</a></p>
    </footer>
  </body>
</html>
