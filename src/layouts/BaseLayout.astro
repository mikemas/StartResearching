---
interface Props {
  title: string;
  description?: string;
  rail?: boolean;
}
const { title, description = 'Start Researching Genealogy — guides, records, and research tips.', rail = false } = Astro.props;
import Nav from '../components/Nav.astro';
import Rail from '../components/Rail.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Start Researching</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* Ported from the live Wells template (site.css) + custom.css:
         sidebar fixed top:50px left:50px width:180px; content margin-left:280px;
         nav proxima-nova 500 16px; active #3bc8de; body 'Work Sans'. */
      :root { --teal: #3bc8de; --teal-hover: rgba(59, 200, 222, 0.53); --ink: #222; --periwinkle: #7b6db0; }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: #fff; color: var(--ink);
        font-family: 'Work Sans', sans-serif;
        font-size: 16px; line-height: 1.7;
      }
      a { color: var(--teal); }

      /* Fixed left sidebar */
      .sidebar {
        position: fixed; top: 50px; left: 50px; width: 180px;
        max-height: calc(100vh - 100px); overflow-y: auto;
      }
      .sidebar .logo { display: block; width: 180px; max-width: 180px; margin-bottom: 30px; line-height: 0; }
      .sidebar .logo img { width: 180px; max-width: 180px; height: auto; }
      nav.main-nav ul { list-style: none; margin: 0; padding: 0; }
      nav.main-nav a {
        display: block; padding: 0.2em 0; color: #030303; text-decoration: none;
        font-family: "proxima-nova", "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-weight: 500; font-size: 16px; line-height: 1.6em;
      }
      nav.main-nav a:hover { color: var(--teal-hover); }
      nav.main-nav a.active { color: var(--teal); }
      .sidebar .secondary { margin-top: 26px; display: flex; flex-direction: column; }
      .sidebar .secondary a {
        display: block; padding: 0.2em 0; color: var(--periwinkle);
        text-decoration: none; font-size: 16px; line-height: 1.6em;
      }
      .sidebar .secondary a:hover { color: var(--teal-hover); }

      .content { margin: 40px 40px 40px 280px; }
      .columns { display: flex; gap: 60px; align-items: flex-start; }
      main { flex: 1 1 auto; min-width: 0; }

      /* Blog stream */
      .post { margin: 0 0 76px; }
      .post-title {
        font-family: "proxima-nova", "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 26px; font-weight: 500; line-height: 1.2; letter-spacing: 0.01em;
        margin: 0 0 10px;
      }
      .post-title a { color: #050505; text-decoration: none; }
      .post-title a:hover { color: var(--teal); }
      .post-footer { margin-top: 26px; font-size: 13px; }
      .post-footer a { color: #999; text-decoration: none; }
      .post-footer a:hover { color: var(--teal); }
      .archive-link { margin: 20px 0 60px; }

      /* Article content */
      article img { max-width: 100%; height: auto; display: block; margin: 0 auto 34px; }
      figure { margin: 1.6em 0; text-align: center; }
      figcaption, .image-caption, .sqs-image-caption { color: #888; font-size: 13px; margin-top: 6px; }
      article h1, article h2, article h3 { line-height: 1.3; font-weight: 600; }
      blockquote { border-left: 3px solid var(--teal); margin: 1.5em 0; padding: 0.2em 0 0.2em 1em; color: #555; }
      table { border-collapse: collapse; width: 100%; font-size: 14px; }
      th, td { border: 1px solid #e6e6e6; padding: 6px 10px; text-align: left; }
      .sqs-gallery-container { text-align: center; }
      .sqs-gallery-container .thumb-image {
        width: 158px !important; height: 158px !important;
        object-fit: cover; display: inline-block !important;
        margin: 4px !important; vertical-align: top;
      }
      .sqs-gallery-meta { display: none; }
      button.lightbox { all: unset; }

      footer.site-footer { color: #999; font-size: 13px; padding: 10px 0 44px; }
      footer.site-footer a { color: #999; }
      footer.site-footer a:hover { color: var(--teal); }

      @media screen and (max-width: 767px) {
        .sidebar { position: static; width: auto; max-height: none; padding: 24px 22px 0; }
        .sidebar .logo, .sidebar .logo img { width: 150px; }
        nav.main-nav ul { display: flex; flex-wrap: wrap; gap: 4px 18px; margin-top: 6px; }
        .sidebar .secondary { flex-direction: row; flex-wrap: wrap; gap: 4px 16px; margin-top: 10px; }
        .content { margin: 0; padding: 26px 22px 60px; }
      }
    </style>
  </head>
  <body>
    <aside class="sidebar">
      <a class="logo" href="/" aria-label="Start Researching home">
        <img src="/images/logo.png" alt="Start Researching Genealogy" />
      </a>
      <Nav />
      <div class="secondary">
        <a href="https://www.etsy.com/shop/startresearching">Our Etsy Shop</a>
        <a href="/contact-me">Contact</a>
        <a href="/ciphers">Ciphers</a>
        <a href="/voynich-blog">Voynich</a>
      </div>
    </aside>
    <div class="content">
      <div class="columns">
        <main>
          <slot />
        </main>
        {rail && <Rail />}
      </div>
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} Start Researching Genealogy</p>
      </footer>
    </div>
  </body>
</html>
