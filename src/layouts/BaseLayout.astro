---
interface Props {
  title: string;
  description?: string;
  rail?: boolean;
  canonical?: string;
}
const { title, description = 'Start Researching Genealogy — guides, records, and research tips.', rail = true, canonical } = Astro.props;
import Nav from '../components/Nav.astro';
import Rail from '../components/Rail.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title} | Start Researching</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* Ported from the live Wells template (site.css) + custom.css:
         sidebar fixed top:50px left:50px width:180px; content margin-left:280px;
         nav proxima-nova 500 16px; active #3bc8de; body 'Work Sans'.
         proxima-nova self-hosted in /fonts (weights 300-700 + italics). */
      @font-face {
        font-family: "proxima-nova"; font-style: normal; font-weight: 300;
        font-display: swap;
        src: url("/fonts/proxima-nova-300-s1.woff2") format("woff2"), url("/fonts/proxima-nova-300-s2.woff2") format("woff2");
      }
      @font-face {
        font-family: "proxima-nova"; font-style: normal; font-weight: 400;
        font-display: swap;
        src: url("/fonts/proxima-nova-400-s1.woff2") format("woff2"), url("/fonts/proxima-nova-400-s2.woff2") format("woff2");
      }
      @font-face {
        font-family: "proxima-nova"; font-style: normal; font-weight: 500;
        font-display: swap;
        src: url("/fonts/proxima-nova-500-s1.woff2") format("woff2"), url("/fonts/proxima-nova-500-s2.woff2") format("woff2");
      }
      @font-face {
        font-family: "proxima-nova"; font-style: normal; font-weight: 600;
        font-display: swap;
        src: url("/fonts/proxima-nova-600-s1.woff2") format("woff2"), url("/fonts/proxima-nova-600-s2.woff2") format("woff2");
      }
      @font-face {
        font-family: "proxima-nova"; font-style: normal; font-weight: 700;
        font-display: swap;
        src: url("/fonts/proxima-nova-700-s1.woff2") format("woff2"), url("/fonts/proxima-nova-700-s2.woff2") format("woff2");
      }
      @font-face {
        font-family: "proxima-nova"; font-style: italic; font-weight: 400;
        font-display: swap;
        src: url("/fonts/proxima-nova-400i-s1.woff2") format("woff2"), url("/fonts/proxima-nova-400i-s2.woff2") format("woff2");
      }
      @font-face {
        font-family: "proxima-nova"; font-style: italic; font-weight: 500;
        font-display: swap;
        src: url("/fonts/proxima-nova-500i-s1.woff2") format("woff2"), url("/fonts/proxima-nova-500i-s2.woff2") format("woff2");
      }
      @font-face {
        font-family: "proxima-nova"; font-style: italic; font-weight: 700;
        font-display: swap;
        src: url("/fonts/proxima-nova-700i-s1.woff2") format("woff2"), url("/fonts/proxima-nova-700i-s2.woff2") format("woff2");
      }
      :root { --teal: #3bc8de; --teal-hover: rgba(59, 200, 222, 0.53); --ink: #222; --periwinkle: #7b6db0; }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: #fff; color: var(--ink);
        font-family: 'Work Sans', sans-serif;
        font-size: 16px; line-height: 1.7;
      }
      a { color: var(--teal); }

      /* Left sidebar scrolls with the page, like the live template */
      .sidebar {
        position: absolute; top: 50px; left: 50px; width: 180px;
      }
      .sidebar .logo { display: block; width: 180px; max-width: 180px; margin-bottom: 30px; line-height: 0; }
      .sidebar .logo img { width: 180px; max-width: 180px; height: auto; }
      nav.main-nav ul { list-style: none; margin: 0; padding: 0; }
      nav.main-nav a {
        display: block; padding: 0.2em 0; color: #030303; text-decoration: none;
        font-family: "proxima-nova", "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-weight: 500; font-size: 16px; line-height: 1.6em;
      }
      nav.main-nav a:hover { color: var(--teal-hover); }
      nav.main-nav a.active { color: var(--teal); }
      nav.main-nav summary {
        display: block; padding: 0.2em 0; color: #030303; cursor: pointer;
        list-style: none;
        font-family: "proxima-nova", "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-weight: 500; font-size: 16px; line-height: 1.6em;
      }
      nav.main-nav summary::-webkit-details-marker { display: none; }
      nav.main-nav summary::marker { content: ''; }
      nav.main-nav summary:hover { color: var(--teal-hover); }
      nav.main-nav summary.active { color: var(--teal); }
      nav.main-nav .subnav { list-style: none; margin: 0; padding: 0; }
      .sidebar .secondary { margin-top: 26px; display: flex; flex-direction: column; }
      .sidebar .secondary a {
        display: block; padding: 0.2em 0; color: #7b6db0;
        text-decoration: none;
        font-family: "proxima-nova", "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-weight: 500; font-size: 16px; line-height: 1.6em;
      }
      .sidebar .secondary a:hover { color: var(--teal-hover); }

      .content { margin: 40px 40px 40px 280px; }
      .columns { display: flex; gap: 60px; align-items: flex-start; }
      main { flex: 1 1 auto; min-width: 0; }

      /* Blog stream */
      .post { margin: 0 0 76px; }
      .post-title {
        font-family: "proxima-nova", "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 26px; font-weight: 500; line-height: 1.2; letter-spacing: 0.01em;
        margin: 0 0 10px;
      }
      .post-title a { color: #050505; text-decoration: none; }
      .post-title a:hover { color: var(--teal); }
      .post-footer { margin-top: 26px; font-size: 13px; }
      .post-footer a { color: #999; text-decoration: none; }
      .post-footer a:hover { color: var(--teal); }
      .post-meta { color: #999; font-size: 13px; margin: 8px 0 24px; }
      .post-meta a { color: #999; text-decoration: none; }
      .post-meta a:hover { color: var(--teal); }
      .archive-link { margin: 20px 0 60px; }

      /* Article copy: proxima-nova 14px/1.6 per computed styles */
      article {
        font-family: "proxima-nova", "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 14px; line-height: 1.6; letter-spacing: 0.02em; color: #000;
      }
      article img { max-width: 100%; height: auto; display: block; margin: 0 auto 34px; }
      figure { margin: 1.6em 0; text-align: center; }
      figcaption, .image-caption, .sqs-image-caption {
        font-family: 'Work Sans', sans-serif; font-size: 14px; line-height: 1.6;
        letter-spacing: 0.02em; color: #000; margin-top: 6px;
      }
      article h2 {
        font-family: "proxima-nova", "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 20.8px; font-weight: 500; line-height: 1.2;
        letter-spacing: 0.01em; color: #050505;
      }
      article h1, article h3 { line-height: 1.3; font-weight: 500; }
      blockquote { border-left: 3px solid var(--teal); margin: 1.5em 0; padding: 0.2em 0 0.2em 1em; color: #555; }
      table { border-collapse: collapse; width: 100%; font-size: 14px; }
      th, td { border: 1px solid #e6e6e6; padding: 6px 10px; text-align: left; }
      /* Squarespace column rows become flex grids */
      .sqs-row { display: flex; flex-wrap: wrap; gap: 0 20px; }
      .sqs-row > .col { flex: 1 1 0; min-width: 0; }
      /* Squarespace summary lists: thumbnail left, text right */
      .summary-item-list.sqs-gallery { display: block; }
      .summary-item-list .summary-item {
        display: flex; gap: 24px; align-items: flex-start; margin-bottom: 34px;
      }
      .summary-item-list .summary-thumbnail-outer-container { flex: 0 0 140px; min-width: 0; }
      .summary-item-list .summary-thumbnail img { width: 100%; height: auto; margin: 0; }
      .summary-item-list .summary-content { flex: 1 1 auto; min-width: 0; }
      .summary-title { font-size: 17px; font-weight: 500; margin: 0 0 6px; }
      .summary-title > a { color: #7b6db0; text-decoration: none; }
      .summary-title > a:hover { color: var(--teal); }
      .summary-read-more-link, .summary-metadata-container { display: none; }
      .sqs-gallery { display: flex; flex-wrap: wrap; gap: 20px; }
      .sqs-gallery .slide { flex: 1 1 180px; min-width: 0; }
      .sqs-gallery .slide img {
        width: 100% !important; height: auto !important;
        margin: 0 auto !important; display: block !important;
      }
      .sqs-gallery-meta { display: none; }
      button.lightbox { all: unset; }
      .v6-visually-hidden {
        position: absolute !important; width: 1px !important; height: 1px !important;
        padding: 0 !important; margin: -1px !important; overflow: hidden !important;
        clip: rect(0, 0, 0, 0) !important; white-space: nowrap !important; border: 0 !important;
      }

      footer.site-footer { color: #999; font-size: 13px; padding: 10px 0 44px; }
      footer.site-footer a { color: #999; }
      footer.site-footer a:hover { color: var(--teal); }

      .menu-toggle { display: none; }
      @media screen and (max-width: 1100px) {
        .columns { flex-wrap: wrap; }
      }
      @media screen and (max-width: 767px) {
        .sqs-row { flex-direction: column; }        .sidebar { position: static; width: auto; padding: 24px 22px 0; }
        .sidebar .logo, .sidebar .logo img { width: 150px; }
        .sidebar .desktop-nav { display: none; }
        .menu-toggle { display: block; margin-top: 14px; }
        .menu-toggle summary {
          cursor: pointer; list-style: none; text-align: center;
          border: 1px solid #c9c9c9; padding: 10px; font-size: 15px; color: #555;
        }
        .menu-toggle summary::-webkit-details-marker { display: none; }
        .menu-toggle nav.main-nav ul { flex-direction: column; gap: 12px; margin: 16px 0 0; }
        .menu-toggle .secondary { display: flex; flex-direction: column; gap: 8px; margin: 14px 0 4px; }
        .content { margin: 0; padding: 26px 22px 60px; }
      }
    </style>
  </head>
  <body>
    <aside class="sidebar">
      <a class="logo" href="/" aria-label="Start Researching home">
        <img src="/images/logo.png" alt="Start Researching Genealogy" />
      </a>
      <div class="desktop-nav">
        <Nav />
        <div class="secondary">
          <a href="https://www.etsy.com/shop/startresearching">Our Etsy Shop</a>
          <a href="/contact-me">Contact</a>
          <a href="/ciphers">Ciphers</a>
          <a href="/voynich-blog">Voynich</a>
        </div>
      </div>
      <details class="menu-toggle">
        <summary>Menu</summary>
        <Nav />
        <div class="secondary">
          <a href="https://www.etsy.com/shop/startresearching">Our Etsy Shop</a>
          <a href="/contact-me">Contact</a>
          <a href="/ciphers">Ciphers</a>
          <a href="/voynich-blog">Voynich</a>
        </div>
      </details>
    </aside>
    <div class="content">
      <div class="columns">
        <main>
          <slot />
        </main>
        {rail && <Rail />}
      </div>
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} Start Researching Genealogy</p>
      </footer>
    </div>
  </body>
</html>
