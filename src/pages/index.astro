---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 10);

const rendered = await Promise.all(
  posts.map(async (post) => ({
    post,
    slug: post.slug ?? post.id.replace(/\.mdx?$/, ''),
    Content: (await render(post)).Content,
    dateStr: post.data.pubDate.toLocaleDateString('en-US', {
      year: 'numeric', month: 'long', day: 'numeric',
    }),
  }))
);
---
<BaseLayout title="Genealogy Research Guides, Records & Tips" rail>
  {rendered.map(({ post, slug, Content, dateStr }) => (
    <article class="post">
      <h1 class="post-title"><a href={`/blog/${slug}/`}>{post.data.title}</a></h1>
      <Content />
      <p class="post-footer"><a href={`/blog/${slug}/#comments-placeholder`}>Comment</a></p>
    </article>
  ))}
  <p class="archive-link"><a href="/blog/">Older posts →</a></p>
</BaseLayout>
