---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))];
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = (await getCollection('blog'))
  .filter((p) => (p.data.tags ?? []).includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const rendered = await Promise.all(
  posts.map(async (post) => ({
    post,
    slug: post.slug ?? post.id.replace(/\.mdx?$/, ''),
    Content: (await render(post)).Content,
    dateStr: post.data.pubDate.toLocaleDateString('en-US', {
      year: 'numeric', month: 'long', day: 'numeric',
    }),
  }))
);
---
<BaseLayout title={`Posts tagged "${tag}"`} rail>
  {rendered.map(({ post, slug, Content, dateStr }) => (
    <article class="post">
      <h1 class="post-title"><a href={`/blog/${slug}/`}>{post.data.title}</a></h1>
      <p class="post-meta"><a href={`/blog/${slug}/`}>{dateStr}</a></p>
      <Content />
      <p class="post-footer"><a href={`/blog/${slug}/#comments-placeholder`}>Comment</a></p>
    </article>
  ))}
</BaseLayout>
