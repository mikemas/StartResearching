---
// Mirrors current Squarespace nav: https://www.startresearching.com/
const sections = [
  { label: '10 Steps to Start', href: '/10-steps' },
  { label: 'Blog Posts', href: '/blog' },
  { label: 'Citing Sources', href: '/citing-sources' },
  { label: 'Databases', href: '/databases' },
  { label: 'DNA Testing', href: '/dna-testing' },
  { label: 'Helpful Guides', href: '/helpful-guides' },
  { label: 'Improving Skills', href: '/improving-skills' },
  { label: 'Interviewing', href: '/interviewing' },
  { label: 'Lineage Memberships', href: '/lineage-memberships' },
  { label: 'Records', href: '/records' },
  { label: 'Search Methods', href: '/search-methods' },
  { label: 'Software', href: '/software' },
  { label: 'Surname Searches', href: '/surname-searches' },
  { label: 'Templates', href: '/tools-templates' },
  { label: 'The GPS', href: '/gps' },
  { label: 'Types of Sources', href: '/types-of-sources' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  if (href === '/blog') return path === '/' || path === '/blog' || path.startsWith('/blog/');
  return path === href || path.startsWith(href + '/');
};
---
<nav aria-label="Primary" class="main-nav">
  <ul>
    {sections.map((s) => (
      <li><a href={s.href} class={isActive(s.href) ? 'active' : undefined}>{s.label}</a></li>
    ))}
  </ul>
</nav>
