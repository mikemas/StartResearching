---
// Mirrors current Squarespace nav: Helpful Guides + Improving Skills are
// expandable folders (no pages), everything else is a link.
type Link = { kind: 'link'; label: string; href: string };
type Folder = { kind: 'folder'; label: string; children: { label: string; href: string }[] };
const sections: (Link | Folder)[] = [
  { kind: 'link', label: '10 Steps to Start', href: '/10-steps' },
  { kind: 'link', label: 'Blog Posts', href: '/blog' },
  { kind: 'link', label: 'Citing Sources', href: '/citing-sources' },
  { kind: 'link', label: 'Databases', href: '/databases' },
  { kind: 'link', label: 'DNA Testing', href: '/dna-testing' },
  {
    kind: 'folder', label: 'Helpful Guides',
    children: [
      { label: 'Abbreviations', href: '/abbreviations/abbreviations' },
      { label: 'Formatting', href: '/formatting/formattingnbsp' },
      { label: 'Glossary', href: '/glossary/glossary' },
      { label: 'Handwriting', href: '/handwriting/handwriting' },
      { label: 'Nickname List', href: '/nickname-list/nickname-lists' },
      { label: 'Search Fields', href: '/search-fields/search-field-tips' },
      { label: 'US Timeline', href: '/us-timeline/history' },
    ],
  },
  {
    kind: 'folder', label: 'Improving Skills',
    children: [
      { label: 'Analyzing Records', href: '/analyzing-records' },
      { label: 'Becoming a Professional', href: '/becoming-a-professional/becoming-a-professional' },
      { label: 'Correlating Evidence', href: '/correlating-evidence/correlating-evidence' },
      { label: 'Education', href: '/education/educationnbsp' },
      { label: 'Mapping Ancestors', href: '/mapping-ancestors/nbspmapping-ancestors' },
      { label: 'Places to Go', href: '/places-to-go/places-to-go-research' },
      { label: 'Preserving Records', href: '/preserving-records/nbsppreserving-records' },
      { label: 'Transcribing Records', href: '/transcribing-records/transcribing-records' },
    ],
  },
  { kind: 'link', label: 'Interviewing', href: '/interviewing' },
  { kind: 'link', label: 'Lineage Memberships', href: '/lineage-memberships' },
  { kind: 'link', label: 'Records', href: '/records' },
  { kind: 'link', label: 'Search Methods', href: '/search-methods' },
  { kind: 'link', label: 'Software', href: '/software' },
  { kind: 'link', label: 'Surname Searches', href: '/surname-searches' },
  { kind: 'link', label: 'Templates', href: '/tools-templates' },
  { kind: 'link', label: 'The GPS', href: '/gps' },
  { kind: 'link', label: 'Types of Sources', href: '/types-of-sources' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  if (href === '/blog') return path === '/' || path === '/blog' || path.startsWith('/blog/');
  return path === href || path.startsWith(href + '/');
};
const folderActive = (f: Folder) => f.children.some((c) => isActive(c.href));
const { flat = false } = Astro.props;
---
<nav aria-label="Primary" class="main-nav">
  <ul>
    {sections.map((s) =>
      s.kind === 'link' ? (
        <li><a href={s.href} class={isActive(s.href) ? 'active' : undefined}>{s.label}</a></li>
      ) : (
        <li class="folder">
          {flat ? (
            <>
              <span class="folder-label">{s.label}</span>
              <ul class="subnav">
                {s.children.map((c) => (
                  <li><a href={c.href}>{c.label}</a></li>
                ))}
              </ul>
            </>
          ) : (
          <details open={folderActive(s) || undefined}>
            <summary class={folderActive(s) ? 'active' : undefined}>{s.label}</summary>
            <ul class="subnav">
              {s.children.map((c) => (
                <li><a href={c.href} class={isActive(c.href) ? 'active' : undefined}>{c.label}</a></li>
              ))}
            </ul>
          </details>
          )}
        </li>
      )
    )}
  </ul>
</nav>
