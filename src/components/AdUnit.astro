---
import { ADSENSE_CLIENT } from '../config';
interface Props {
  slot: string;
}
const { slot } = Astro.props;
---
<ins
  class="adsbygoogle"
  style="display:block"
  data-ad-client={ADSENSE_CLIENT}
  data-ad-slot={slot}
  data-ad-format="auto"
  data-full-width-responsive="true"></ins>
<script is:inline>
  (adsbygoogle = window.adsbygoogle || []).push({});
</script>
